{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AIBox",
  "version": "0.1.0",
  "identifier": "app.aibox.studio",
  "build": {
    "beforeDevCommand": "pnpm --dir ../.. --filter @aibox/web dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm --dir ../.. --filter @aibox/web build:desktop",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "AIBox · 本地 AI 工作台",
        "label": "main",
        "width": 1440,
        "height": 960,
        "minWidth": 960,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "theme": "Dark",
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Local-first AI model studio with Whisper ASR",
    "longDescription": "AIBox is a local-first AI model studio. Download Whisper models, run speech recognition on CPU or NVIDIA CUDA, and export SRT/VTT/TXT/JSON without sending audio to the cloud.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/aibox-server"]
  }
}

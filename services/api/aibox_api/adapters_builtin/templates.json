{
  "schema_version": 1,
  "templates": [
    {
      "id": "sensevoice-small",
      "name": "SenseVoice Small",
      "kind": "asr",
      "description": "阿里 FunASR 的多语言语音识别模型，中文/粤语/英语/日语/韩语，带情绪与事件标签能力。",
      "languages": "中 / 英 / 粤 / 日 / 韩",
      "parameters": "234M",
      "memory_gb": 2.0,
      "license": "FunASR License",
      "source": "FunASR / ModelScope",
      "homepage": "https://github.com/modelscope/FunASR",
      "tags": [
        "FunASR",
        "多语言",
        "中文"
      ],
      "aliases": [
        "sensevoice"
      ],
      "install": "安装 FunASR，准备 SenseVoiceSmall 权重，并用一段 Python/CLI 脚本把 {audio} 转成 {output} JSON。",
      "docs": "FunASR 不是 OpenAI 标准 API。推荐写一个 20 行脚本调用 AutoModel，读取 {audio}，写出包含 text/segments 的 JSON。",
      "adapter_example": {
        "type": "command",
        "command": [
          "python",
          "<path-to-funasr-runner>.py",
          "--audio",
          "{audio}",
          "--output",
          "{output}",
          "--model",
          "<path-to-SenseVoiceSmall>"
        ],
        "output": "json",
        "timeout_seconds": 900
      }
    },

# Copy to .env and adjust. Never commit real tokens.

# Local API / WebUI
AIBOX_HOST=127.0.0.1
AIBOX_PORT=8765
AIBOX_DATA_DIR=
AIBOX_MAX_UPLOAD_MB=512
# AIBOX_REPO_ROOT=
# AIBOX_WEB_DIST=apps/web/dist

# External protocols
# AIBOX_API_TOKEN=change-me
# AIBOX_PUBLIC_BASE_URL=https://aibox.example.com
AIBOX_GRPC_ENABLED=true
AIBOX_GRPC_HOST=127.0.0.1
AIBOX_GRPC_PORT=50051
AIBOX_MRCP_ENABLED=true
AIBOX_MRCP_HOST=127.0.0.1
AIBOX_MRCP_PORT=8060
AIBOX_MRCP_CONTROL_PORT=8061
AIBOX_MRCP_RTP_PORT_START=50000
AIBOX_MRCP_RTP_PORT_END=50100
# Client-reachable address advertised in SDP; required for remote SIP.
# AIBOX_MRCP_ADVERTISE_HOST=192.0.2.10

# Model downloads
# HF_TOKEN=
# AIBOX_HF_ENDPOINT=https://hf-mirror.com

# IndexTTS runtime (run scripts/setup-indextts.ps1)
# AIBOX_INDEXTTS_HOME=F:\path\to\index-tts
# AIBOX_INDEXTTS_PYTHON=F:\path\to\index-tts\.venv\Scripts\python.exe
# AIBOX_DEMO_TTS=1

# Community adapters
# AIBOX_ADAPTERS_DIR=
# AIBOX_ALLOW_ADAPTER_COMMANDS=1
# AIBOX_ALLOW_REMOTE_ADAPTERS=1

# Image generation
# AIBOX_DEMO_IMAGE=1
# AIBOX_COMFYUI_URL=http://127.0.0.1:8188
# AIBOX_IMAGE_PYTHON=C:\path\to\image-venv\Scripts\python.exe

# Vocal / background separation
# AIBOX_DEMO_SEPARATION=1
# AIBOX_SEPARATION_PYTHON=C:\path\to\separation-venv\Scripts\python.exe
# AIBOX_SEPARATION_DEVICE=auto

# Video generation
# AIBOX_DEMO_VIDEO=1
# MINIMAX_API_KEY=
# AIBOX_MINIMAX_BASE_URL=https://api.minimax.io/v1
# AIBOX_MINIMAX_MODEL=MiniMax-H3

# Language models
# AIBOX_DEMO_LLM=1
# AIBOX_LLAMA_SERVER=C:\llama.cpp\build\bin\llama-server.exe
# AIBOX_LLM_BASE_URL=http://127.0.0.1:11434/v1
# NewAPI on server 4:
# AIBOX_LLM_BASE_URL=https://newapi.franj2.top/v1
# AIBOX_LLM_API_KEY=<NewAPI Token>
# AIBOX_LLM_MODEL=<model-id>
# AIBOX_LLM_API_KEY=
# AIBOX_LLM_MODEL=qwen3-8b
# AIBOX_LLM_CONTEXT=8192
# AIBOX_LLM_GPU_LAYERS=99

# External LLM runtimes
# AIBOX_VLLM_BASE_URL=http://127.0.0.1:8000/v1
# AIBOX_VLLM_MODEL=Qwen/Qwen3-8B
# AIBOX_SGLANG_BASE_URL=http://127.0.0.1:30000/v1
# AIBOX_SGLANG_MODEL=Qwen/Qwen3-8B
# AIBOX_MLX_BASE_URL=http://127.0.0.1:8080/v1
# AIBOX_MLX_MODEL=mlx-community/Qwen2.5-7B-Instruct-4bit
# AIBOX_TENSORRT_LLM_BASE_URL=http://127.0.0.1:8000/v1
# AIBOX_TENSORRT_LLM_MODEL=Qwen/Qwen3-8B
# AIBOX_LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
# AIBOX_LMSTUDIO_MODEL=local-model
# AIBOX_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# AIBOX_OLLAMA_MODEL=qwen3:8b
# AIBOX_LLM_TP_SIZE=1
# AIBOX_LLM_PP_SIZE=1
# AIBOX_LLM_DIST_BACKEND=none

# Fine-tuning
# AIBOX_DEMO_TRAINING=1
# AIBOX_TRAIN_COMMAND=C:\train-venv\Scripts\python.exe C:\train\finetune.py --base {base_model} --data {dataset} --out {output_dir} --method {method} --epochs {epochs} --parallel {parallel}

# Translation
# AIBOX_DEMO_TRANSLATION=1
# AIBOX_TRANSLATION_PROVIDER=auto
# AIBOX_LIBRE_URL=http://127.0.0.1:5000
# AIBOX_LIBRE_API_KEY=
# AIBOX_INDEX_URL=
# AIBOX_INDEX_API_KEY=
# AIBOX_INDEX_MODEL=Index-Translate
# AIBOX_HUNYUAN_URL=
# AIBOX_HUNYUAN_API_KEY=
# AIBOX_HUNYUAN_MODEL=hunyuan-mt2
# AIBOX_ARGOS_COMMAND=argos-translate

# OCR
# AIBOX_DEMO_OCR=1
# AIBOX_OCR_PROVIDER=auto
# AIBOX_GLM_API_KEY=
# AIBOX_GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# AIBOX_GLM_OCR_MODEL=glm-ocr
# AIBOX_OCR_OPENAI_URL=
# AIBOX_OCR_OPENAI_API_KEY=
# AIBOX_OCR_OPENAI_MODEL=gpt-4o-mini
# AIBOX_TESSERACT_COMMAND=tesseract

# Multi-node cluster
# AIBOX_CLUSTER_ENABLED=1
# AIBOX_CLUSTER_TOKEN=
# AIBOX_CLUSTER_NODE_TTL=20
# AIBOX_CLUSTER_MAX_RETRIES=2
# AIBOX_CLUSTER_MODE=master_slave

# WebUI accounts / RBAC
# AIBOX_AUTH_ENABLED=1
# AIBOX_AUTH_MODE=builtin
# AIBOX_AUTH_SESSION_HOURS=12
# AIBOX_AUTH_EXTERNAL_HEADER=X-Forwarded-User
# AIBOX_AUTH_EXTERNAL_ROLES_HEADER=X-Forwarded-Roles

# Optional demo engine for UI/CI
# AIBOX_DEMO_ASR=1
